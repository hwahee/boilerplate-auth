{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/server/index.ts",
    "src/client/main.tsx",
    "src/client/ui/overlay/declarative.ts",
    "src/client/pages/home-page.tsx",
    "src/client/pages/design-system-page.tsx",
    "src/client/auth/account-controls.tsx",
    "src/**/*.test.{ts,tsx}",
    "scripts/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
  "ignoreBinaries": ["index.js"]
}
